# ==============================================================================
# Mishkati (مِشكاتي) - Siraj AI Configuration (.env)
# ==============================================================================

# 1. Google Gemini API Key (Recommended: Gemini 1.5 Pro / Flash)
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Selected AI Model
# Options: 'gemini-1.5-pro' (Default - Deepest reasoning & strict factual grounding)
#          'gemini-1.5-flash' (Ultra-fast, low latency)
#          'gpt-4o' (OpenAI Flagship)
SIRAJ_MODEL=gemini-1.5-pro

# 3. Optional OpenAI Fallback (Used if GEMINI_API_KEY is not set)
# OPENAI_API_KEY=your_openai_api_key_here
